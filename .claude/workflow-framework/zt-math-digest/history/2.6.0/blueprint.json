{
  "protocol": "workflow-framework-protocol/1",
  "name": "zt-math-digest",
  "version": "2.6.0",
  "description": "Digest a Chinese-translated mathematics textbook into ZET Cards: the ZT digest base with the mathematics profile and the math stages (statement skeleton and notation, Boundary, Proof, Theory, the M1-M18 check), built and frozen by the workflow framework",
  "whenToUse": "Turn a Scholar Archive mathematics textbook (Chinese bilingual Markdown with numbered definitions and theorems) into an agent Literature tree of mathematical units and Theory Cards; mode math re-runs only Boundary, Proof, Theory, and the math check on an existing math digest; the other modes are those of the base.",
  "preflight": {
    "P1": "Goal and result: zt-math-digest.js on the framework: the base digest plus the math stages, with the base result and math: {index, docs, skeleton, notation, boundary, proof, theory, check}; mode math returns {mode, dsh_model, citation_key, math}. The base 2.1.2 adds the Bridge report and isolated apply mode.",
    "P2": "Inputs: the base's args plus supply, unitsPerJob, mainResults, coreBudget, notation, boundary, proof, theory (data and declared switches). Base Bridge arguments are inherited; base 2.4.0 adds args.book, the Scholar Archive Work id or title that resolves the book.",
    "P3": "Units of work: as the base, plus the numbered statements (math-compiler.ps1 index) and unitsPerJob units per boundary or proof job, one Theory Card per chapter.",
    "P4": "Roles: as the base. Every math step and its DeepSeek managers run as the Haiku manager role.",
    "P5": "Stage graph: the base chain with the slots filled: after-prepare: math-skeleton; after-digest: models (the model layer with the math supplements) → math-boundary → math-proof, and explain (mode explain); after-link: math-theory (the cited premises are complete after the link pass); after-audit: math-check. Figures → Bridge → Hubs; Bridge profile math.",
    "P6": "Modules (the mathematics set): the profile (dsh-digest-base.zh.md plus dsh-model-cards.zh.md, then math-prefix.md and math-link-prefix.md from math-compiler.ps1 -Step docs; -BriefDoc, -FillDoc, -ReviewDoc; model-architect-math.md; Theory Cards out of the model compiler), zt-model-layer and zt-explain (zt-model-lib), zt-math-skeleton, zt-math-boundary, zt-math-proof, zt-math-theory, zt-math-check (zt-math-lib). No Event Card: the event layer is the economics set's. zt-bridge v3.",
    "P7": "Checks: as the base; the boundary review job checks each supplied counterexample; the proof review checks every step; math-check reports M1-M18. Bridge BR1–BR9, exact report acceptance and guarded edits.",
    "P8": "Failure policy: a failed index, docs, or skeleton step halts the run; a failed notation table is logged and the digest goes on. Switches: models, notation, boundary, proof, theory. Modes: the base modes plus models, explain, math. Bridge failure is nonfatal in full; bridge apply runs only args, Bridge and report.",
    "P9": "Dry run: zt-math-digest.sim.json. Fixture: tests/framework-harness.mjs runs all checks of the removed math-workflow-harness.mjs on the built script (2.3.0: base 2.2.0, the ported scripts run as zt-digest tools; 2.4.0: base 2.3.0, every digest script runs as its zt-digest tool, math-compiler as zt-digest math), and checks that the shared stages build the same commands in both book types. Pilot: one chapter after a database backup. bridge-workflow-harness.mjs and Bridge scratch tests; verify frozen installation and real report-only pilot separately."
  },
  "roles": {
    "manager": {
      "model": "haiku",
      "effort": "low",
      "description": "Haiku: relays one script command, runs DeepSeek managers and clean-ups"
    },
    "architect": {
      "model": "sonnet",
      "description": "Sonnet: the model architect, writes plan.json only"
    },
    "organizer": {
      "model": "opus",
      "description": "Opus: the Organize decisions, writes decisions.json only"
    }
  },
  "args": {
    "out": {
      "type": "string",
      "required": true,
      "description": "the digest's staging folder"
    },
    "citationKey": {
      "type": "string",
      "description": "the book's BibTeX key (all modes but hubs and audit)"
    },
    "source": {
      "type": "string",
      "description": "the book's Chinese or bilingual Markdown (mode full)"
    },
    "bibtex": {
      "type": "string",
      "description": "the BibTeX entry (mode full)"
    },
    "bookTitle": {
      "type": "string",
      "description": "the book's title (mode full)"
    },
    "book": {
      "type": "any",
      "description": "a Scholar Archive Work id or an exact title: mode full resolves the Work, its Chinese/bilingual Markdown, the BibTeX and the heading range instead of source, bibtex and bookTitle"
    },
    "fileId": {
      "type": "any",
      "description": "the book Markdown's Scholar Archive file id"
    },
    "startHeading": {
      "type": "string",
      "description": "the Chinese heading where the digested text starts"
    },
    "endHeading": {
      "type": "string",
      "description": "the Chinese heading where the digested text stops"
    },
    "skipHeadings": {
      "type": "string",
      "description": "headings whose units are left out, e.g. 参考文献,习题"
    },
    "groups": {
      "type": "number",
      "description": "the existing group count (modes link and models)"
    },
    "organize": {
      "type": "any",
      "description": "true: Organize after modes link, models, hubs; \"legacy\": the old single Opus job"
    },
    "perManager": {
      "type": "number",
      "min": 1,
      "description": "digest groups per Haiku manager (default 5, at most 8)"
    },
    "maxChars": {
      "type": "number",
      "description": "the most characters of a group (default 20000)"
    },
    "maxUnits": {
      "type": "number",
      "description": "the most units of a group (default 3)"
    },
    "dshSource": {
      "type": "string",
      "enum": [
        "auto",
        "official",
        "opencode"
      ],
      "description": "where DeepSeek V4.1 Flash runs; auto probes official, then OpenCode Go"
    },
    "dshModel": {
      "type": "string",
      "description": "a DeepSeek Harness model that overrides dshSource"
    },
    "dshEffort": {
      "type": "string",
      "description": "DeepSeek effort of digest, link, and fill runs (raised to high)"
    },
    "models": {
      "type": "boolean",
      "description": "false: skip the model stage"
    },
    "rebuild": {
      "type": "boolean",
      "description": "rebuild models that already have parts"
    },
    "redoModels": {
      "type": "boolean",
      "description": "the old name of rebuild"
    },
    "perSonnet": {
      "type": "number",
      "min": 1,
      "description": "formal models per architect batch (default 6)"
    },
    "perConcept": {
      "type": "number",
      "min": 1,
      "description": "concept models per batch (default 10)"
    },
    "dshPerBatch": {
      "type": "number",
      "min": 1,
      "description": "DeepSeek runs one Haiku manager keeps going (default 8, at most 8)"
    },
    "dshPerSonnet": {
      "type": "number",
      "min": 1,
      "description": "the old name of dshPerBatch"
    },
    "dshManagers": {
      "type": "number",
      "min": 1,
      "description": "Haiku managers of one compiler step in parallel (default 8, at most 8)"
    },
    "linkPerManager": {
      "type": "number",
      "min": 1,
      "description": "link runs one Haiku manager starts at once (default 8)"
    },
    "applyShare": {
      "type": "number",
      "min": 1,
      "description": "jobs one card-cycle apply call writes (default 30)"
    },
    "only": {
      "type": "array",
      "description": "the Model Card addresses to work on (a pilot)"
    },
    "level": {
      "type": "string",
      "enum": [
        "concept",
        "formal"
      ],
      "description": "build every model of the run to this level"
    },
    "briefEffort": {
      "type": "string",
      "description": "DeepSeek effort of the briefs (raised to high)"
    },
    "deriveEffort": {
      "type": "string",
      "description": "DeepSeek effort of the Derivation parts (raised to high)"
    },
    "reviewEffort": {
      "type": "string",
      "description": "DeepSeek effort of the review (raised to high)"
    },
    "reviewRounds": {
      "type": "number",
      "min": 0,
      "description": "review, split, review again (default 2; 0 skips)"
    },
    "maxSentences": {
      "type": "number",
      "description": "Card size of a formal model part: sentences (default 12)"
    },
    "maxPartChars": {
      "type": "number",
      "description": "Card size of a formal model part: characters (default 400)"
    },
    "maxSteps": {
      "type": "number",
      "description": "steps per Derivation part (default 6)"
    },
    "maxExplainSentences": {
      "type": "number",
      "description": "explanation budget: sentences (default 16)"
    },
    "maxExplainChars": {
      "type": "number",
      "description": "explanation budget: characters (default 600)"
    },
    "hubs": {
      "type": "boolean",
      "description": "mode full: false skips the hub stage; mode link: true runs it"
    },
    "hubWork": {
      "type": "string",
      "description": "the hub stage's folder and DeepSeek workspace (default D:\\zt-digest\\hubs)"
    },
    "hubLimits": {
      "type": "object",
      "description": "limits that override the Haiku hub manager's choice"
    },
    "hubTrees": {
      "type": "string",
      "description": "only these Topic trees (a pilot), e.g. 130,122"
    },
    "hubRebuild": {
      "type": "boolean",
      "description": "rewrite every hub"
    },
    "hubEffort": {
      "type": "string",
      "description": "DeepSeek effort of the hub writers (raised to high)"
    },
    "hubFixRounds": {
      "type": "number",
      "min": 0,
      "description": "hub check, fix, apply rounds (default 1)"
    },
    "terms": {
      "type": "boolean",
      "description": "mode full: false skips the book term table"
    },
    "audit": {
      "type": "boolean",
      "description": "mode full: false skips the audit"
    },
    "figures": {
      "type": "boolean",
      "description": "mode full: false skips the Figures stage"
    },
    "cardChecks": {
      "type": "boolean",
      "description": "modes full and link: false skips the card layer cycle"
    },
    "ideaSample": {
      "type": "number",
      "min": 0,
      "max": 1,
      "description": "share of fault-free Idea Cards reviewed against the source (mode full: 0.1)"
    },
    "cardRules": {
      "type": "string",
      "description": "the rules the card cycle fixes (default all hard rules)"
    },
    "cardFixRounds": {
      "type": "number",
      "min": 0,
      "description": "card check, fix, apply rounds (default 1)"
    },
    "cardMax": {
      "type": "number",
      "min": 1,
      "description": "a pilot: at most this many Cards with faults and orphans"
    },
    "explainMax": {
      "type": "number",
      "min": 1,
      "description": "mode explain, a pilot: at most this many Derivation parts"
    },
    "bridge": {
      "type": "boolean",
      "description": "full mode: false skips Bridge discovery"
    },
    "bridgeCandidates": {
      "type": "number",
      "min": 1,
      "max": 8,
      "description": "similarity candidates per source, default 5 plus at most two literal matches"
    },
    "bridgeBooks": {
      "type": "string",
      "description": "comma-separated eligible target book keys"
    },
    "bridgeReport": {
      "type": "string",
      "description": "exact published report id; only mode bridge"
    },
    "bridgeMax": {
      "type": "number",
      "min": 1,
      "max": 120,
      "description": "selected Bridge sources, default 60"
    },
    "bridgeApply": {
      "type": "any",
      "description": "all or a unique array of new-carrier ids from bridgeReport"
    },
    "bridgeApplyEarlier": {
      "type": "any",
      "description": "separate all or unique array of earlier-carrier ids from bridgeReport"
    },
    "supply": {
      "type": "string",
      "enum": [
        "none",
        "examples",
        "examples+answers"
      ],
      "description": "what DeepSeek may add that the book does not give (default examples)"
    },
    "unitsPerJob": {
      "type": "number",
      "min": 1,
      "description": "units per boundary or proof job (default 4)"
    },
    "mainResults": {
      "type": "number",
      "min": 1,
      "description": "main results per Theory Card (default 7)"
    },
    "coreBudget": {
      "type": "number",
      "min": 1,
      "description": "core parts per unit (default 3; read by the architect's math supplement)"
    },
    "notation": {
      "type": "boolean",
      "description": "mode full: false skips the Book notation table"
    },
    "boundary": {
      "type": "boolean",
      "description": "false skips Boundary"
    },
    "proof": {
      "type": "boolean",
      "description": "false skips the proof review"
    },
    "theory": {
      "type": "boolean",
      "description": "false skips the Theory pass"
    }
  },
  "consts": {
    "profile": {
      "book": "mathematics",
      "instructions": "dsh-digest-base.zh.md,dsh-model-cards.zh.md",
      "noEventCandidates": true,
      "digestPrefix": "math-prefix.md",
      "linkPrefix": "math-link-prefix.md",
      "compilerDocs": {
        "BriefDoc": "math\\brief.zh.md",
        "FillDoc": "math\\fill.zh.md",
        "ReviewDoc": "math\\review.zh.md"
      },
      "architectSupplement": {
        "file": "model-architect-math.md",
        "name": "the math supplement"
      },
      "skipForms": [
        "theory"
      ],
      "bridgeProfile": "math"
    }
  },
  "stages": [
    {
      "id": "args",
      "title": "Prepare",
      "detail": "the required args per mode",
      "module": "gate",
      "params": {
        "subject": {
          "args": "{{args}}",
          "mode": "{{mode}}"
        },
        "checks": [
          {
            "op": "or",
            "value": [
              {
                "path": "mode",
                "op": "matches",
                "value": "^(hubs|audit)$"
              },
              {
                "path": "args.citationKey",
                "op": "nonempty"
              }
            ],
            "message": "args must be an object with citationKey"
          },
          {
            "op": "or",
            "value": [
              {
                "path": "mode",
                "op": "!=",
                "value": "full"
              },
              {
                "path": "args.book",
                "op": "nonempty"
              },
              {
                "op": "and",
                "value": [
                  {
                    "path": "args.source",
                    "op": "nonempty"
                  },
                  {
                    "path": "args.bibtex",
                    "op": "nonempty"
                  },
                  {
                    "path": "args.bookTitle",
                    "op": "nonempty"
                  }
                ]
              }
            ],
            "message": "mode full needs args book, or args source, bibtex, and bookTitle"
          },
          {
            "op": "or",
            "value": [
              {
                "op": "and",
                "value": [
                  {
                    "path": "args.bridgeReport",
                    "op": "empty"
                  },
                  {
                    "path": "args.bridgeApply",
                    "op": "empty"
                  },
                  {
                    "path": "args.bridgeApplyEarlier",
                    "op": "empty"
                  }
                ]
              },
              {
                "op": "and",
                "value": [
                  {
                    "path": "mode",
                    "op": "==",
                    "value": "bridge"
                  },
                  {
                    "path": "args.bridgeReport",
                    "op": "nonempty"
                  },
                  {
                    "op": "or",
                    "value": [
                      {
                        "path": "args.bridgeApply",
                        "op": "nonempty"
                      },
                      {
                        "path": "args.bridgeApplyEarlier",
                        "op": "nonempty"
                      }
                    ]
                  }
                ]
              }
            ],
            "message": "Bridge acceptance requires mode bridge, a report id, and a nonempty selection"
          },
          {
            "op": "or",
            "value": [
              {
                "path": "args.bridgeMax",
                "op": "empty"
              },
              {
                "path": "args.bridgeMax",
                "op": "matches",
                "value": "^(?:[1-9][0-9]{0,2})$"
              }
            ],
            "message": "bridgeMax must be a whole number in 1..120"
          },
          {
            "op": "or",
            "value": [
              {
                "path": "args.bridgeCandidates",
                "op": "empty"
              },
              {
                "path": "args.bridgeCandidates",
                "op": "matches",
                "value": "^(?:[1-9][0-9]{0,2})$"
              }
            ],
            "message": "bridgeCandidates must be a whole number in 1..8"
          }
        ]
      }
    },
    {
      "id": "source",
      "title": "Prepare",
      "detail": "the DeepSeek source (probe official, then OpenCode Go)",
      "after": [
        "args"
      ],
      "module": "zt-dsh-source",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}"
      },
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "!=",
              "value": "bridge"
            },
            {
              "op": "and",
              "value": [
                {
                  "path": "args.bridgeReport",
                  "op": "empty"
                },
                {
                  "path": "args.bridgeApply",
                  "op": "empty"
                },
                {
                  "path": "args.bridgeApplyEarlier",
                  "op": "empty"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "prepare",
      "title": "Prepare",
      "detail": "Chinese-only book text, section groups, the Literature tree with anchors, the shared prefixes",
      "after": [
        "source"
      ],
      "module": "zt-digest-prepare",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "needGroups": [
          "full",
          "link"
        ],
        "instructions": "{{consts.profile.instructions}}",
        "noEventCandidates": "{{consts.profile.noEventCandidates}}"
      }
    },
    {
      "id": "math-skeleton",
      "title": "Prepare",
      "detail": "math-compiler.ps1: the statement index, the math prompt files, the unit and Theory Card skeleton; one DeepSeek job writes the Book notation table",
      "module": "zt-math-skeleton",
      "when": [
        {
          "path": "mode",
          "op": "==",
          "value": "full"
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      },
      "after": [
        "prepare"
      ]
    },
    {
      "id": "terms",
      "title": "Prepare",
      "detail": "the book term table (book-terms.ps1 and one DeepSeek job)",
      "after": [
        "math-skeleton"
      ],
      "module": "zt-book-terms",
      "onFail": "continue",
      "when": [
        {
          "path": "args.terms",
          "op": "!=",
          "value": false
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "cards-book",
      "title": "Cards",
      "detail": "one whole-book card cycle after the digest runs (mode full), or on its own (mode cards); it also reviews the source of every Model draft no model chain elaborates",
      "after": [
        "digest"
      ],
      "module": "zt-cards-book",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "cards"
            },
            {
              "op": "and",
              "value": [
                {
                  "path": "mode",
                  "op": "==",
                  "value": "full"
                },
                {
                  "path": "args.cardChecks",
                  "op": "!=",
                  "value": false
                }
              ]
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "digest",
      "title": "Digest",
      "detail": "Haiku managers drive the DeepSeek digest runs per block (Idea Cards and anchors; the book type's prompt supplements add its own Cards); the cheap per-group deterministic check is the group completion's own offline check",
      "after": [
        "terms"
      ],
      "module": "zt-digest-blocks",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "profile": "{{consts.profile}}",
        "groups": "{{stages.prepare.output.groups}}"
      }
    },
    {
      "id": "models",
      "title": "Models",
      "detail": "the model layer: the model compiler on every Model Card of the book (DeepSeek brief → Sonnet plan → DeepSeek fill, derive, review, split)",
      "module": "zt-model-layer",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "op": "and",
              "value": [
                {
                  "path": "mode",
                  "op": "==",
                  "value": "full"
                },
                {
                  "path": "args.models",
                  "op": "!=",
                  "value": false
                }
              ]
            },
            {
              "path": "mode",
              "op": "==",
              "value": "models"
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "profile": "{{consts.profile}}"
      },
      "after": [
        "digest"
      ]
    },
    {
      "id": "explain",
      "title": "Models",
      "detail": "mode explain: 思路, 说明, and 解读 for finished Derivation parts",
      "module": "zt-explain",
      "when": [
        {
          "path": "mode",
          "op": "==",
          "value": "explain"
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      },
      "after": [
        "digest"
      ]
    },
    {
      "id": "math-boundary",
      "title": "Boundary",
      "detail": "hypothesis roles, counterexamples, and contrast pairs (DeepSeek JSON, a second job checks each supplied one)",
      "module": "zt-math-boundary",
      "when": [
        {
          "path": "mode",
          "op": "matches",
          "value": "^(full|math)$"
        },
        {
          "path": "args.boundary",
          "op": "!=",
          "value": false
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      },
      "after": [
        "models"
      ]
    },
    {
      "id": "math-proof",
      "title": "Proof",
      "detail": "a DeepSeek reviewer checks every proof plan, proof step, and conclusion",
      "after": [
        "math-boundary"
      ],
      "module": "zt-math-proof",
      "when": [
        {
          "path": "mode",
          "op": "matches",
          "value": "^(full|math)$"
        },
        {
          "path": "args.proof",
          "op": "!=",
          "value": false
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "hubs-first",
      "title": "Hubs",
      "detail": "mode hubs: the hub compiler on the whole agent Workspace",
      "after": [
        "explain",
        "math-proof"
      ],
      "module": "zt-hubs",
      "when": [
        {
          "path": "mode",
          "op": "==",
          "value": "hubs"
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "link-prepare",
      "title": "Link",
      "detail": "prepare-link-pass.ps1: link files and the pending groups",
      "after": [
        "hubs-first",
        "cards-book"
      ],
      "module": "zt-link-prepare",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "groups": "{{stages.prepare.output.groups}}"
      }
    },
    {
      "id": "link",
      "title": "Link",
      "detail": "DeepSeek link runs append reasoned cross-part Links",
      "after": [
        "link-prepare"
      ],
      "module": "zt-link-pass",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "profile": "{{consts.profile}}",
        "groups": "{{stages.prepare.output.groups}}",
        "pending": {
          "$ref": "stages.link-prepare.output.pending",
          "default": []
        }
      }
    },
    {
      "id": "link-check",
      "title": "Cards",
      "detail": "the card layer cycle on the new Links and the orphans",
      "after": [
        "link"
      ],
      "module": "zt-link-check",
      "when": [
        {
          "path": "args.cardChecks",
          "op": "!=",
          "value": false
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "math-theory",
      "title": "Theory",
      "detail": "each Theory Card: question, main results, objects (DeepSeek); dependency order, tools, map (script)",
      "module": "zt-math-theory",
      "when": [
        {
          "path": "mode",
          "op": "matches",
          "value": "^(full|math)$"
        },
        {
          "path": "args.theory",
          "op": "!=",
          "value": false
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      },
      "after": [
        "link-check"
      ]
    },
    {
      "id": "cleanup",
      "title": "Cleanup",
      "detail": "delete leftover DeepSeek conversations, remove the workspace and scratch files, read the usage ledger",
      "after": [
        "math-theory"
      ],
      "module": "zt-dsh-cleanup",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "usageBefore": {
          "$ref": "stages.prepare.output.usage_before"
        },
        "usageBeforeLink": {
          "$ref": "stages.link-prepare.output.usage_before"
        },
        "groups": "{{stages.prepare.output.groups}}",
        "linkRuns": {
          "$ref": "stages.link.output.reports",
          "default": []
        }
      }
    },
    {
      "id": "organize",
      "title": "Organize",
      "detail": "survey → Opus decisions.json → apply → notes card cycle → skeleton (Literature index, structure Card, Topic bodies)",
      "after": [
        "cleanup"
      ],
      "module": "zt-organize",
      "onFail": "continue",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "full"
            },
            {
              "path": "args.organize",
              "op": "matches",
              "value": "^(true|legacy)$"
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "groups": "{{stages.prepare.output.groups}}",
        "digest": {
          "$ref": "stages.digest.output.reports"
        },
        "link": {
          "$ref": "stages.link.output.reports"
        },
        "models": {
          "$ref": "stages.models.output.models"
        }
      }
    },
    {
      "id": "figures",
      "title": "Figures",
      "detail": "attach-figures.ps1: the book's own figures in the Cards that name them",
      "after": [
        "organize"
      ],
      "module": "zt-figures",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "figures"
            },
            {
              "path": "args.figures",
              "op": "!=",
              "value": false
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}"
      }
    },
    {
      "id": "bridge",
      "title": "Bridge",
      "detail": "bounded frozen cross-book discovery and immutable review report; explicit accepted apply in bridge mode",
      "after": [
        "figures"
      ],
      "module": "zt-bridge",
      "onFail": "continue",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "bridge"
            },
            {
              "op": "and",
              "value": [
                {
                  "path": "mode",
                  "op": "==",
                  "value": "full"
                },
                {
                  "path": "args.bridge",
                  "op": "!=",
                  "value": false
                }
              ]
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "profile": "{{consts.profile.bridgeProfile}}"
      },
      "expect": [
        {
          "path": "status",
          "op": "!=",
          "value": "failed"
        }
      ]
    },
    {
      "id": "hubs",
      "title": "Hubs",
      "detail": "the hub compiler on the whole agent Workspace, after Organize",
      "after": [
        "bridge"
      ],
      "module": "zt-hubs",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "op": "and",
              "value": [
                {
                  "path": "mode",
                  "op": "==",
                  "value": "full"
                },
                {
                  "path": "args.hubs",
                  "op": "!=",
                  "value": false
                }
              ]
            },
            {
              "op": "and",
              "value": [
                {
                  "path": "mode",
                  "op": "==",
                  "value": "link"
                },
                {
                  "path": "args.hubs",
                  "op": "true"
                }
              ]
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        }
      }
    },
    {
      "id": "audit",
      "title": "Audit",
      "detail": "digest-audit.ps1, read-only: faults per rule, orphans, models, figures, hubs",
      "after": [
        "hubs"
      ],
      "module": "zt-audit",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "audit"
            },
            {
              "path": "args.audit",
              "op": "!=",
              "value": false
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}"
      }
    },
    {
      "id": "math-check",
      "title": "Audit",
      "detail": "math-compiler.ps1 check: rules M1 to M18 on every unit and Theory Card",
      "module": "zt-math-check",
      "when": [
        {
          "op": "or",
          "value": [
            {
              "path": "mode",
              "op": "==",
              "value": "math"
            },
            {
              "op": "and",
              "value": [
                {
                  "path": "args.audit",
                  "op": "!=",
                  "value": false
                },
                {
                  "path": "args.citationKey",
                  "op": "nonempty"
                }
              ]
            }
          ]
        }
      ],
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}"
      },
      "after": [
        "audit"
      ]
    },
    {
      "id": "report",
      "title": "Report",
      "detail": "the run's result per mode",
      "after": [
        "math-check"
      ],
      "module": "zt-digest-report",
      "params": {
        "args": "{{args}}",
        "mode": "{{mode}}",
        "model": {
          "$ref": "stages.source.output.model"
        },
        "groups": {
          "$ref": "stages.prepare.output.groups"
        },
        "digest": {
          "$ref": "stages.digest.output"
        },
        "terms": {
          "$ref": "stages.terms.output"
        },
        "cardsBook": {
          "$ref": "stages.cards-book.output"
        },
        "hubsFirst": {
          "$ref": "stages.hubs-first.output"
        },
        "link": {
          "$ref": "stages.link.output"
        },
        "linkCheck": {
          "$ref": "stages.link-check.output"
        },
        "cleanup": {
          "$ref": "stages.cleanup.output"
        },
        "organize": {
          "$ref": "stages.organize.output"
        },
        "figures": {
          "$ref": "stages.figures.output"
        },
        "hubs": {
          "$ref": "stages.hubs.output"
        },
        "audit": {
          "$ref": "stages.audit.output"
        },
        "extra": {
          "math": {
            "index": {
              "$ref": "stages.math-skeleton.output.index"
            },
            "docs": {
              "$ref": "stages.math-skeleton.output.docs"
            },
            "skeleton": {
              "$ref": "stages.math-skeleton.output.skeleton"
            },
            "notation": {
              "$ref": "stages.math-skeleton.output.notation"
            },
            "boundary": {
              "$ref": "stages.math-boundary.output"
            },
            "proof": {
              "$ref": "stages.math-proof.output"
            },
            "theory": {
              "$ref": "stages.math-theory.output"
            },
            "check": {
              "$ref": "stages.math-check.output"
            }
          }
        },
        "bridge": {
          "$ref": "stages.bridge.output"
        },
        "models": {
          "$ref": "stages.models.output"
        },
        "explain": {
          "$ref": "stages.explain.output"
        }
      }
    }
  ],
  "modes": {
    "link": [
      "args",
      "source",
      "prepare",
      "link-prepare",
      "link",
      "link-check",
      "cleanup",
      "organize",
      "hubs",
      "report"
    ],
    "cards": [
      "args",
      "source",
      "prepare",
      "cards-book",
      "report"
    ],
    "hubs": [
      "args",
      "source",
      "prepare",
      "hubs-first",
      "organize",
      "report"
    ],
    "figures": [
      "args",
      "figures",
      "report"
    ],
    "audit": [
      "args",
      "audit",
      "report"
    ],
    "bridge": [
      "args",
      "source",
      "bridge",
      "report"
    ],
    "models": [
      "args",
      "source",
      "prepare",
      "models",
      "organize",
      "report"
    ],
    "explain": [
      "args",
      "source",
      "prepare",
      "explain",
      "report"
    ],
    "math": [
      "args",
      "source",
      "prepare",
      "math-boundary",
      "math-proof",
      "math-theory",
      "math-check",
      "report"
    ]
  },
  "checkpoints": [
    "digest"
  ],
  "result": {
    "$ref": "stages.report.output"
  },
  "composedFrom": {
    "base": "zt-digest-base",
    "version": "2.5.0"
  }
}
